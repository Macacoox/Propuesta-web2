# Copia este archivo como .env.local y rellena los valores.
# En Vercel: Project → Settings → Environment Variables.

# Clave de la API de OpenAI (obligatoria). NUNCA la subas al repositorio.
OPENAI_API_KEY=

# Modelo de OpenAI (opcional, por defecto gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Muestra el panel "Modo pruebas" para simular fallos de OpenAI.
# Activo siempre con `npm run dev`. En Vercel, pon 1 solo si quieres enseñarlo.
NEXT_PUBLIC_MODO_PRUEBAS=
